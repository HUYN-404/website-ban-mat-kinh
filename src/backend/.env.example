# Sao chép file này thành `.env` rồi điền giá trị thật (KHÔNG commit file .env lên GitHub)

DJANGO_SECRET_KEY=thay-bang-chuoi-bi-mat
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ten-user
DB_PASS=mat-khau
DB_NAME=shop-ban-kinh-mat

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- VNPay (điền từ tài khoản sandbox: https://sandbox.vnpayment.vn/merchantv2/) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8000/api/payments/vnpay/return
FRONTEND_BASE_URL=http://localhost:5174

# --- Email (Gmail SMTP) — tạo App Password tại https://myaccount.google.com/apppasswords ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SeeU Eyewear <no-reply@seeu.vn>
